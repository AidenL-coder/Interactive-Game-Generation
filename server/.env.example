# Copy to server/.env and fill in. Never commit the filled-in file.

# Required. Drives the narrative turns, the per-game art direction, and (3D engine only)
# object geometry. Without it /api/2d/sessions fails.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
PORT=3001

# Illustration for the 2D game: the backdrop, every object and character cut-out, and the
# portraits shown when someone speaks. Get a key at https://aistudio.google.com/apikey.
# Without it /api/2d/art returns 503 and the stage falls back to painted silhouettes —
# still playable, but not the real thing. Also drives the 3D engine's textures.
GOOGLE_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image

# Optional, 3D engine only: real 3D prop models (GLB) via text-to-3D, replacing the
# billboarded sprites. Get a key at https://www.meshy.ai/api. Without it /api/model
# returns 503 and props fall back to sprites — a supported mode, not a failure.
# Generation takes 1-4 minutes per prop type, once, then caches to disk forever.
MESHY_API_KEY=
