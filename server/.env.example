ANTHROPIC_API_KEY=
PORT=3001
CLAUDE_MODEL=claude-sonnet-5

# Optional: enables AI-generated scene textures via the Gemini Developer API
# (get a key at https://aistudio.google.com/apikey). Without it, /api/texture returns
# 503 and the renderer uses its procedural fallback — a supported mode, not a failure.
GOOGLE_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image
